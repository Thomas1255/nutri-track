# Browser-safe configuration. Copy to .env.local and restart Vite.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional HTTPS website URL for email confirmation redirects in native builds.
VITE_AUTH_REDIRECT_URL=
# Never put USDA_API_KEY, secret keys, or service-role keys in VITE_ variables.
# Set USDA_API_KEY and ALLOWED_ORIGINS in Supabase Edge Function secrets instead.
